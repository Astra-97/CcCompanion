[Unit]
Description=Restricted Xia Yizhou AI Session Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cc-xia-relay
Group=cc-xia-relay
UMask=0077
WorkingDirectory=/var/lib/cc-xia-relay/workspace
Environment=AI_RELAY_EXECUTION_MODE=chat_only
Environment=AI_RELAY_INSTANCE_ROOT=/var/lib/cc-xia-relay
Environment=AI_RELAY_WORKSPACE=/var/lib/cc-xia-relay/workspace
Environment=AI_RELAY_STATE_DIR=/var/lib/cc-xia-relay/state
Environment=CLAUDE_CONFIG_DIR=/var/lib/cc-xia-relay/state/claude-home
Environment=CODEX_HOME=/var/lib/cc-xia-relay/state/codex-home
Environment=HOME=/var/lib/cc-xia-relay/state/runtime-home
Environment=AI_RELAY_PROVIDER=claude
Environment=AI_RELAY_HOST=127.0.0.1
Environment=AI_RELAY_PORT=8900
Environment=AI_RELAY_CLAUDE_BIN=/usr/bin/claude
Environment=AI_RELAY_CODEX_BIN=/opt/cc-xia-ai-session-relay/bin/codex
Environment=PATH=/opt/cc-xia-ai-session-relay/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/cc-xia-ai-session-relay/source/.venv/bin/python /opt/cc-xia-ai-session-relay/source/relay_server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/cc-xia-relay/state
BindReadOnlyPaths=/root/CcCompanion/apns-server/state/ai_relay_workspace:/var/lib/cc-xia-relay/workspace
ReadOnlyPaths=/opt/cc-xia-ai-session-relay

[Install]
WantedBy=multi-user.target
