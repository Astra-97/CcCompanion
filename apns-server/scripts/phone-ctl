#!/usr/bin/env python3
"""phone-ctl — 小克操作方小南的真机 (CC Companion App v1.9.227+ 「手机操控」, Shizuku)。

链路: phone-ctl → 本机 CcCompanion 服务 /phone/tasks (任务队列) → 手机 App 前台服务
长轮询领任务 → Shizuku UserService (uid 2000/shell) 执行 → 回传结果。连接由手机发起,
换网络 / 走流量都能用; 手机端有总开关 + 分档权限 (查看状态 / 截屏 / 点按输入 / 文件 / Shell),
没开的档位会直接报「手机端没开 xx 权限」。

用法:
  phone-ctl status                    手机在不在线 + 电量/亮屏/前台 app/Shizuku/已开权限
  phone-ctl app                       当前前台 app 包名
  phone-ctl apps [--all]              已装 app 包名 (默认只列第三方)
  phone-ctl open <包名>               打开 app
  phone-ctl key <键名> [--long]       按键: home back recent power enter delete volume_up ...
  phone-ctl home | back | recent      常用键快捷写法
  phone-ctl shot [out.jpg] [--max 1280] [--quality 70] [--png] [--full]
                                      截屏 (默认长边缩到 1280 的 JPEG; --full 原尺寸 PNG)
  phone-ctl tap X Y                   点按 (物理像素坐标)
  phone-ctl swipe X1 Y1 X2 Y2 [毫秒]  滑动
  phone-ctl longpress X Y [毫秒]      长按
  phone-ctl text "你好" [--enter] [--mode auto|input|paste]
                                      输入文字 (ASCII 走 input text; 中文/换行走剪贴板+粘贴)
  phone-ctl push <本地文件> [手机路径] [--overwrite]
                                      传文件到手机 (默认 /sdcard/Download/; 以 / 结尾当目录)
                                      断点续传 + 大小/sha256 校验 + 失败自动重试 (手机端做)
  phone-ctl pull <手机路径> [本地路径] 从手机拉文件回来 (≤128MB)
  phone-ctl ls [手机路径]             列目录 (默认 /sdcard)
  phone-ctl stat <手机路径>           文件大小/时间
  phone-ctl sh "<命令>" [--timeout 秒] 通用 shell (uid 2000; 手机端 Shell 档默认关闭)
  phone-ctl tasks                     最近任务

「小克的本地能力」(App v1.9.233+, 不需要 Shizuku / 手机操控总开关; App 在后台开着
「实时提醒」就能收到; 每项在 App → 设置 → 小克的本地能力 里单独开关):
  phone-ctl local                     各项本地能力的开关 / 权限状态 (App 最近一次上报)
  phone-ctl alarm HH:MM [--msg 文字] [--days 1,2,3|workdays|weekend|daily]
                                      在她的系统时钟里建闹钟 (时间按手机本地时间; 1=周一)
  phone-ctl timer 秒数|5m|1h30m [--msg 文字]   系统时钟倒计时
  phone-ctl alarms                    打开她的时钟闹钟列表 (会弹界面)
  phone-ctl health [YYYY-MM-DD|today|yesterday] [--range N]
                                      读 Health Connect: 睡眠/步数/心率/体重/血氧/血压… (N 天, 截止该日)
  phone-ctl calendar sync [--no-wait] 把日程本同步进她手机上独立的「小克日程」日历 (并刷新小部件;
                                      schedule-ctl 每次改动会自动在后台跑 --no-wait 版)
  phone-ctl ring [--msg 文字] [--seconds N] [--volume 80]
                                      强提醒 / 找手机: 全屏 + 闹钟音量响铃 + 震动, 直到她点停
  phone-ctl ring --stop               远程停掉正在响的强提醒
  phone-ctl clip "文字"               写进她的剪贴板 + 小通知「小克复制了：…」
  phone-ctl widget                    让桌面小部件马上刷新
  phone-ctl places                    她在手机上设的地点 (只有名字和半径, 没有坐标)
  phone-ctl notifs [--since 1h] [--clear]
                                      白名单 App (外卖/快递) 转发来的通知 (最近 200 条 / 48h)
  退出码: 0 成功; 1 失败 (原因已打印); 2 闹钟/计时器在等她点通知确认 (还没真设上)
  phone-ctl cancel <任务id>
  通用参数: --json 输出原始 JSON; --wait 秒 (等结果的最长时间)

鉴权 X-Auth-Token = config.toml shared_secret (只在进程内读取, 不打印)。
/phone/tasks 只接受本机 (127.0.0.1 直连) 投递。
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

CONFIG = Path(os.environ.get("CC_COMPANION_CONFIG", "/root/CcCompanion/apns-server/config.toml"))
TIER_ZH = {"status": "查看状态", "screen": "截屏", "input": "点按输入", "files": "文件", "shell": "Shell"}
SHIZUKU_ZH = {
    "ready": "就绪",
    "not_installed": "没装 Shizuku",
    "not_running": "Shizuku 没在运行（手机重启后要在 Shizuku 里用无线调试重新启动）",
    "no_permission": "Shizuku 在跑，但还没给 CC Companion 授权",
    "binding": "正在连接 Shizuku 服务",
    "service_error": "Shizuku 服务连接失败",
}


class CtlError(Exception):
    pass


def _config() -> tuple[str, str]:
    base = os.environ.get("PHONE_CTL_BASE", "").rstrip("/")
    secret = os.environ.get("PHONE_CTL_SECRET", "")
    if base and secret:
        return base, secret
    text = CONFIG.read_text(encoding="utf-8")
    port = 8291
    section = ""
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("["):
            section = line
            continue
        m = re.match(r'^shared_secret\s*=\s*"(.*)"\s*$', line)
        if m and not secret:
            secret = m.group(1)
        m = re.match(r"^port\s*=\s*(\d+)\s*$", line)
        if m and section == "[server]":
            port = int(m.group(1))
    if not secret:
        raise CtlError("config.toml 里没有 shared_secret")
    return base or f"http://127.0.0.1:{port}", secret


def _request(method: str, path: str, body: dict | None = None, *, timeout: float = 30,
             raw: bool = False):
    base, secret = _config()
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(base + path, data=data, method=method)
    req.add_header("X-Auth-Token", secret)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            payload = resp.read()
            if raw:
                return payload, resp.headers.get("Content-Type", "")
            return json.loads(payload.decode("utf-8")) if payload else {}
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read().decode("utf-8"))
        except Exception:
            err = {"ok": False, "error": f"HTTP {e.code}"}
        msg = err.get("message") or err.get("error") or f"HTTP {e.code}"
        raise CtlError(f"{msg} (HTTP {e.code})") from None
    except (urllib.error.URLError, OSError) as e:
        raise CtlError(f"连不上 CcCompanion 服务: {e}") from None


LOCAL_ACTIONS = {"alarm", "timer", "show_alarms", "health", "calendar_sync", "ring", "ring_stop",
                 "clip", "widget_refresh", "places"}
FEATURE_ZH = {
    "alarm": "设闹钟 / 计时器", "health": "健康数据", "calendar": "日历「小克日程」",
    "ring": "强提醒 / 找手机", "clip": "剪贴板", "widget": "桌面小部件",
    "notifs": "通知转发", "places": "到达提醒",
}


def enqueue(action: str, args: dict | None = None, *, timeout_s: int | None = None) -> dict:
    body: dict = {"action": action, "args": args or {}}
    if timeout_s is not None:
        body["timeout_s"] = timeout_s
    return _request("POST", "/phone/tasks", body)["task"]


def run_task(action: str, args: dict | None = None, *, wait: float | None = None, timeout_s: int | None = None,
             on_progress=None) -> dict:
    """投递任务并等结果; 返回终态 task dict (status=done 才算成功)。"""
    local = action in LOCAL_ACTIONS
    if wait is None:
        wait = 150 if local else 90
    task = enqueue(action, args, timeout_s=timeout_s)
    device = task.get("device") or {}
    if local:
        info = device.get("local") or {}
        if not info.get("seen"):
            print("phone-ctl: 服务重启以来 App 还没来领过本地任务（App 的「实时提醒」没开 / 被杀后台 / "
                  "还没装 v1.9.233+），先排队等它连上…", file=sys.stderr)
    elif not device.get("online"):
        ago = device.get("seconds_ago")
        hint = "从没来过" if ago is None else f"上次来是 {ago} 秒前"
        print(f"phone-ctl: 手机现在好像不在线（{hint}），先排队等 {task.get('timeout_s')} 秒内领取…",
              file=sys.stderr)
    task_id = task["id"]
    deadline = time.monotonic() + wait
    last_progress = None
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise CtlError(f"等了 {int(wait)} 秒还没结果（任务 {task_id} 仍是 {task['status']}）")
            step = min(remaining, 20 if on_progress is None else 2)
            task = _request("GET", f"/phone/tasks/{task_id}?wait={step:.1f}", timeout=step + 15)["task"]
            if on_progress and task.get("progress") and task["progress"] != last_progress:
                last_progress = task["progress"]
                on_progress(last_progress)
            if task["status"] in ("done", "failed", "timeout", "cancelled"):
                return task
    except KeyboardInterrupt:
        try:
            _request("POST", f"/phone/tasks/{task_id}/cancel", {})
            print("\nphone-ctl: 已取消", file=sys.stderr)
        except CtlError:
            pass
        raise SystemExit(130)


def ensure_done(task: dict) -> dict:
    if task["status"] != "done":
        msg = task.get("message") or task.get("error") or task["status"]
        raise CtlError(f"{msg}（{task['status']}: {task.get('error')}）")
    return task.get("result") or {}


def _fmt_size(n: int | None) -> str:
    if n is None:
        return "?"
    size = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.0f}{unit}" if unit == "B" else f"{size:.1f}{unit}"
        size /= 1024
    return f"{n}B"


def _out(args, data, text: str) -> None:
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=1))
    else:
        print(text)


# ── 子命令 ────────────────────────────────────────────────────────────────


def cmd_status(args) -> None:
    device = _request("GET", "/phone/device")["device"]
    lines = []
    if not device.get("seen"):
        lines.append("手机: 服务重启以来还没来轮询过（App 手机操控总开关没开 / App 不在后台）")
    else:
        state = "在线" if device.get("online") else "离线"
        lines.append(f"手机: {state}（{device.get('seconds_ago')} 秒前来过）App v{device.get('app_version') or '?'}")
        caps = device.get("caps") or []
        lines.append("已开权限: " + ("、".join(TIER_ZH.get(c, c) for c in caps) or "无"))
        sz = device.get("shizuku") or "?"
        lines.append(f"Shizuku: {SHIZUKU_ZH.get(sz, sz)}"
                     + (f" (v{device['shizuku_version']})" if device.get("shizuku_version") else ""))
    result = None
    if device.get("online") and "status" in (device.get("caps") or []):
        try:
            result = ensure_done(run_task("status", wait=args.wait))
        except CtlError as e:
            lines.append(f"状态查询失败: {e}")
    if result:
        bat = result.get("battery")
        lines.append(
            f"电量: {bat}%{'（充电中）' if result.get('charging') else ''}  "
            f"屏幕: {'亮' if result.get('screen_on') else '灭'}{'·已锁' if result.get('locked') else ''}  "
            f"前台: {result.get('foreground') or '?'}"
        )
        if result.get("screen_w"):
            lines.append(f"屏幕尺寸: {result['screen_w']}x{result['screen_h']}")
        if result.get("shizuku_error"):
            lines.append(f"Shizuku 提示: {result['shizuku_error']}")
    _out(args, {"device": device, "status": result}, "\n".join(lines))


def cmd_app(args) -> None:
    r = ensure_done(run_task("foreground", wait=args.wait))
    _out(args, r, r.get("package") or "unknown")


def cmd_apps(args) -> None:
    r = ensure_done(run_task("apps", {"third_party_only": not args.all}, wait=args.wait))
    _out(args, r, "\n".join(r.get("packages") or []))


def cmd_open(args) -> None:
    r = ensure_done(run_task("open", {"package": args.package}, wait=args.wait))
    _out(args, r, f"已打开 {args.package}" + (f"（{r.get('via')}）" if r.get("via") else ""))


def cmd_key(args) -> None:
    key = getattr(args, "key", None) or args.cmd
    r = ensure_done(run_task("key", {"key": key, "long_press": getattr(args, "long", False)}, wait=args.wait))
    _out(args, r, f"按了 {key}")


def cmd_tap(args) -> None:
    r = ensure_done(run_task("tap", {"x": args.x, "y": args.y}, wait=args.wait))
    _out(args, r, f"点了 ({args.x}, {args.y})")


def cmd_swipe(args) -> None:
    r = ensure_done(run_task("swipe", {"x1": args.x1, "y1": args.y1, "x2": args.x2, "y2": args.y2,
                                       "duration_ms": args.ms}, wait=args.wait))
    _out(args, r, f"滑了 ({args.x1},{args.y1}) → ({args.x2},{args.y2}) {args.ms}ms")


def cmd_longpress(args) -> None:
    r = ensure_done(run_task("swipe", {"x1": args.x, "y1": args.y, "x2": args.x, "y2": args.y,
                                       "duration_ms": args.ms}, wait=args.wait))
    _out(args, r, f"长按 ({args.x}, {args.y}) {args.ms}ms")


def cmd_text(args) -> None:
    r = ensure_done(run_task("text", {"text": args.text, "mode": args.mode, "enter": args.enter},
                             wait=args.wait))
    _out(args, r, f"已输入 {len(args.text)} 字（{r.get('via', '?')}）")


def cmd_shot(args) -> None:
    fmt = "png" if (args.png or args.full) else "jpeg"
    max_side = 0 if args.full else args.max
    task = run_task("screenshot", {"max_side": max_side, "quality": args.quality, "format": fmt},
                    wait=args.wait)
    r = ensure_done(task)
    data, _ctype = _request("GET", f"/phone/tasks/{task['id']}/blob", raw=True, timeout=60)
    ext = "png" if fmt == "png" else "jpg"
    out = Path(args.out) if args.out else Path(f"/tmp/phone-shot-{datetime.now():%Y%m%d-%H%M%S}.{ext}")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(data)
    scale = r.get("scale") or 1
    text = (f"{out}  {r.get('width')}x{r.get('height')}（手机原始 {r.get('orig_width')}x{r.get('orig_height')}）"
            f" {_fmt_size(len(data))}")
    if scale and scale != 1:
        text += f"\n点按坐标 = 图上坐标 ÷ {scale:.4f}（≈ ×{1 / scale:.3f}）"
    _out(args, {**r, "path": str(out)}, text)


def cmd_push(args) -> None:
    src = Path(args.local).expanduser().resolve()
    if not src.is_file():
        raise CtlError(f"本地文件不存在: {src}")
    dest = args.dest or "/sdcard/Download/"
    if dest.endswith("/"):
        dest = dest + src.name
    staged = _request("POST", "/phone/files", {"path": str(src)}, timeout=600)["file"]
    total = staged["size"]
    print(f"已挂出 {src.name} {_fmt_size(total)} sha256={staged['sha256'][:12]}… → {dest}", file=sys.stderr)
    started = time.monotonic()

    def show(progress: dict) -> None:
        done = progress.get("done", 0)
        pct = (done / total * 100) if total else 100
        speed = done / max(0.001, time.monotonic() - started)
        print(f"\r  {pct:5.1f}%  {_fmt_size(done)}/{_fmt_size(total)}  {_fmt_size(int(speed))}/s   ",
              end="", file=sys.stderr, flush=True)

    task = run_task("download", {"file_id": staged["file_id"], "dest": dest, "overwrite": args.overwrite},
                    wait=args.wait if args.wait != 90 else 4 * 3600, timeout_s=args.timeout,
                    on_progress=None if args.json else show)
    if not args.json:
        print(file=sys.stderr)
    r = ensure_done(task)
    _out(args, r, f"已传到 {r.get('path', dest)}  {_fmt_size(r.get('size'))}  sha256 校验通过"
                  + (f"（断点续传 {r['resumed']} 次）" if r.get("resumed") else "")
                  + (f"（重试 {r['attempts'] - 1} 次）" if r.get("attempts", 1) > 1 else "")
                  + ("（手机上已有同样的文件，跳过）" if r.get("already") else ""))


def cmd_pull(args) -> None:
    task = run_task("pull", {"path": args.remote}, wait=args.wait if args.wait != 90 else 1800)
    r = ensure_done(task)
    data, _ = _request("GET", f"/phone/tasks/{task['id']}/blob", raw=True, timeout=600)
    out = Path(args.local) if args.local else Path("/tmp") / Path(args.remote).name
    if out.is_dir():
        out = out / Path(args.remote).name
    out.write_bytes(data)
    _out(args, {**r, "local": str(out)}, f"{out}  {_fmt_size(len(data))}")


def cmd_ls(args) -> None:
    r = ensure_done(run_task("ls", {"path": args.path}, wait=args.wait))
    rows = []
    for e in r.get("entries") or []:
        mtime = datetime.fromtimestamp((e.get("mtime") or 0) / 1000).strftime("%m-%d %H:%M")
        name = e.get("name", "") + ("/" if e.get("dir") else "")
        rows.append(f"{'' if e.get('dir') else _fmt_size(e.get('size')):>8}  {mtime}  {name}")
    if r.get("truncated"):
        rows.append(f"…（只列了前 {len(r.get('entries') or [])} 项）")
    _out(args, r, "\n".join(rows) or "(空)")


def cmd_stat(args) -> None:
    r = ensure_done(run_task("stat", {"path": args.path}, wait=args.wait))
    if not r.get("exists"):
        _out(args, r, "不存在")
        return
    mtime = datetime.fromtimestamp((r.get("mtime") or 0) / 1000).strftime("%Y-%m-%d %H:%M:%S")
    _out(args, r, f"{'目录' if r.get('dir') else '文件'}  {r.get('size')} 字节 ({_fmt_size(r.get('size'))})  {mtime}")


def cmd_sh(args) -> None:
    r = ensure_done(run_task("shell", {"cmd": args.command, "timeout_s": args.timeout},
                             wait=max(args.wait or 90, args.timeout + 30)))
    if args.json:
        _out(args, r, "")
        return
    if r.get("out"):
        sys.stdout.write(r["out"])
    if r.get("err"):
        sys.stderr.write(r["err"])
    if r.get("timed_out"):
        print(f"phone-ctl: 命令超时（{args.timeout}s）被杀", file=sys.stderr)
    raise SystemExit(r.get("code", 0) if isinstance(r.get("code"), int) else 0)


def cmd_tasks(args) -> None:
    data = _request("GET", "/phone/tasks")
    rows = []
    for t in data.get("tasks") or []:
        ts = datetime.fromtimestamp(t["created_at"]).strftime("%H:%M:%S")
        rows.append(f"{ts}  {t['id'][:8]}  {t['action']:<10} {t['status']:<9} {t.get('message') or ''}")
    _out(args, data, "\n".join(rows) or "(没有任务)")


def cmd_cancel(args) -> None:
    tasks = _request("GET", "/phone/tasks").get("tasks") or []
    match = [t for t in tasks if t["id"].startswith(args.task_id)]
    if len(match) != 1:
        raise CtlError("找不到唯一匹配的任务 id")
    r = _request("POST", f"/phone/tasks/{match[0]['id']}/cancel", {})
    _out(args, r, f"{match[0]['id'][:8]} → {r['task']['status']}")


# ── 小克的本地能力 (App v1.9.233+, 不需要 Shizuku) ─────────────────────────────


def _parse_hhmm(raw: str) -> tuple[int, int]:
    m = re.fullmatch(r"(\d{1,2})[:：.](\d{2})", raw.strip())
    if not m or not (0 <= int(m.group(1)) <= 23 and 0 <= int(m.group(2)) <= 59):
        raise CtlError(f"时间要写成 HH:MM（24 小时制），收到 {raw!r}")
    return int(m.group(1)), int(m.group(2))


def _parse_duration(raw: str) -> int:
    text = raw.strip().lower()
    if text.isdigit():
        return int(text)
    m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text)
    if not m or not any(m.groups()):
        raise CtlError(f"时长写成 秒数 / 5m / 1h30m / 90s，收到 {raw!r}")
    h, mi, se = (int(g) if g else 0 for g in m.groups())
    return h * 3600 + mi * 60 + se


def _parse_days(raw: str | None):
    if not raw:
        return []
    alias = raw.strip().lower()
    if alias in ("workdays", "weekdays", "工作日", "weekend", "weekends", "周末", "daily", "everyday", "每天"):
        return alias
    try:
        days = sorted({int(p) for p in re.split(r"[,，\s]+", alias) if p})
    except ValueError:
        raise CtlError("--days 写 1,2,3（1=周一 … 7=周日）或 workdays / weekend / daily") from None
    if any(not 1 <= d <= 7 for d in days):
        raise CtlError("--days 只能是 1-7（1=周一，7=周日）")
    return days


_DAY_ZH = "一二三四五六日"

_STATE_ZH = {
    "set_verified": "已设好（系统「下一个闹钟」已经变成它，确认生效）",
    "set_unverified": "已交给时钟 App（没法从系统确认，通常是已设好）",
    "awaiting_tap": "App 在后台没法直接弹时钟，已发通知等她点一下确认（点之前还没设上）",
}
_VIA_ZH = {"foreground": "App 在前台直接设", "overlay": "后台 + 悬浮窗权限直接设",
           "notification": "发通知等她点"}


def _finish_local(args, task: dict, ok_text) -> int:
    """本地能力统一收尾: 失败抛原因; 成功打印; awaiting_tap 退出码 2。"""
    r = ensure_done(task)
    state = r.get("state")
    text = ok_text(r) if callable(ok_text) else ok_text
    if state in _STATE_ZH:
        text += f"\n状态: {_STATE_ZH[state]}"
    if r.get("via"):
        text += f"（{_VIA_ZH.get(r['via'], r['via'])}）"
    if r.get("reason"):
        text += f"\n说明: {r['reason']}"
    if state == "awaiting_tap":
        text += f"\n她点了之后用 phone-ctl task {task['id'][:8]} 看后续"
    _out(args, {"task_id": task["id"], **r}, text)
    return 2 if state == "awaiting_tap" else 0


def cmd_alarm(args) -> None:
    hour, minutes = _parse_hhmm(args.time)
    body = {"hour": hour, "minutes": minutes, "message": args.msg or "", "days": _parse_days(args.days)}
    task = run_task("alarm", body, wait=args.wait)

    def text(r):
        days = r.get("days") or []
        rep = "" if not days else "，重复: 周" + "、".join(_DAY_ZH[d - 1] for d in days)
        return f"闹钟 {hour:02d}:{minutes:02d}{rep}" + (f"「{args.msg}」" if args.msg else "")
    raise SystemExit(_finish_local(args, task, text))


def cmd_timer(args) -> None:
    seconds = _parse_duration(args.seconds)
    if not 1 <= seconds <= 86400:
        raise CtlError("计时器 1 秒到 24 小时")
    task = run_task("timer", {"seconds": seconds, "message": args.msg or ""}, wait=args.wait)
    raise SystemExit(_finish_local(args, task, f"计时器 {seconds} 秒" + (f"「{args.msg}」" if args.msg else "")))


def cmd_alarms(args) -> None:
    raise SystemExit(_finish_local(args, run_task("show_alarms", wait=args.wait), "已打开时钟的闹钟列表"))


def _resolve_date(raw: str | None) -> str:
    from datetime import timedelta
    from zoneinfo import ZoneInfo
    today = datetime.now(ZoneInfo("Asia/Shanghai")).date()
    if not raw or raw == "today":
        return today.isoformat()
    if raw == "yesterday":
        return (today - timedelta(days=1)).isoformat()
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", raw):
        return raw
    raise CtlError("日期写 YYYY-MM-DD / today / yesterday")


def _fmt_min(m) -> str:
    if m is None:
        return "?"
    m = int(round(m))
    return f"{m // 60}h{m % 60:02d}m"


def cmd_health(args) -> None:
    date = _resolve_date(args.date)
    r = ensure_done(run_task("health", {"date": date, "days": args.range}, wait=args.wait))
    lines = [f"Health Connect {r.get('start_date', date)} → {r.get('end_date', date)}（{r.get('tz', '')}）"]
    for day in r.get("days") or []:
        parts = [day.get("date", "?")]
        sl = day.get("sleep") or {}
        if sl.get("total_min"):
            parts.append(f"睡眠 {_fmt_min(sl['total_min'])}"
                         + (f"（深{_fmt_min(sl.get('deep_min'))} 浅{_fmt_min(sl.get('light_min'))} "
                            f"REM{_fmt_min(sl.get('rem_min'))} 醒{_fmt_min(sl.get('awake_min'))}）"
                            if sl.get("has_stages") else ""))
        if day.get("steps") is not None:
            parts.append(f"步数 {day['steps']}")
        if day.get("distance_m"):
            parts.append(f"{day['distance_m'] / 1000:.2f}km")
        if day.get("active_kcal"):
            parts.append(f"活动 {day['active_kcal']:.0f}kcal")
        hr = day.get("heart_rate") or {}
        if hr.get("avg"):
            parts.append(f"心率 {hr.get('min')}/{hr.get('avg')}/{hr.get('max')}")
        if day.get("resting_hr"):
            parts.append(f"静息 {day['resting_hr']}")
        if day.get("spo2_avg"):
            parts.append(f"血氧 {day['spo2_avg']:.0f}%")
        if day.get("exercise"):
            parts.append("运动 " + "、".join(f"{e.get('type')} {_fmt_min(e.get('minutes'))}" for e in day["exercise"]))
        lines.append("  ".join(parts))
    if r.get("weight"):
        w = r["weight"]
        lines.append(f"体重 {w.get('kg')}kg（{w.get('time', '')[:10]}）")
    if r.get("body_fat"):
        lines.append(f"体脂 {r['body_fat'].get('pct')}%")
    if r.get("blood_pressure"):
        bp = r["blood_pressure"]
        lines.append(f"血压 {bp.get('systolic')}/{bp.get('diastolic')}（{bp.get('time', '')[:16]}）")
    if r.get("missing_permissions"):
        lines.append("没授权的项: " + "、".join(r["missing_permissions"]))
    if r.get("background_note"):
        lines.append(f"注意: {r['background_note']}")
    _out(args, r, "\n".join(lines))


def _nudge_widget() -> None:
    """日程变了, 桌面小部件也顺手刷 (排队不等; 关着 / 失败都无所谓)。"""
    try:
        enqueue("widget_refresh")
    except CtlError:
        pass


def cmd_calendar(args) -> None:
    if args.what != "sync":
        raise CtlError("用法: phone-ctl calendar sync [--no-wait]")
    if args.no_wait:
        task = enqueue("calendar_sync")
        _nudge_widget()
        _out(args, {"task_id": task["id"], "status": task["status"]},
             f"已排队同步「小克日程」（{len(task['args'].get('events') or [])} 条，任务 {task['id'][:8]}）")
        return
    r = ensure_done(run_task("calendar_sync", wait=args.wait))
    _nudge_widget()
    _out(args, r, f"「小克日程」已同步：新增 {r.get('inserted', 0)} / 更新 {r.get('updated', 0)} / "
                  f"删除 {r.get('deleted', 0)} / 不变 {r.get('unchanged', 0)}"
                  + (f"\n说明: {r['reason']}" if r.get("reason") else ""))


def cmd_ring(args) -> None:
    if args.stop:
        r = ensure_done(run_task("ring_stop", wait=args.wait))
        _out(args, r, "已停止强提醒" if r.get("stopped") else "本来就没在响")
        return
    task = run_task("ring", {"message": args.msg or "", "seconds": args.seconds, "volume_pct": args.volume},
                    wait=args.wait)
    r = ensure_done(task)
    bits = [f"在响了（最多 {args.seconds} 秒，她点「停」就停）"]
    bits.append("全屏弹出: " + ("能" if r.get("full_screen") else "不能（只有横幅通知；去「小克的本地能力」开全屏通知权限）"))
    if r.get("volume") is not None:
        bits.append(f"闹钟音量 {r.get('volume')}/{r.get('volume_max')}")
    if r.get("dnd"):
        bits.append(f"勿扰: {r['dnd']}")
    if r.get("reason"):
        bits.append(f"说明: {r['reason']}")
    bits.append(f"停没停 / 谁停的: phone-ctl task {task['id'][:8]}")
    _out(args, {"task_id": task["id"], **r}, "\n".join(bits))


def cmd_clip(args) -> None:
    r = ensure_done(run_task("clip", {"text": args.text, "notify": not args.quiet}, wait=args.wait))
    _out(args, r, f"已写进剪贴板（{len(args.text)} 字）" + ("" if r.get("notified") else "（通知没发出来）"))


def cmd_widget(args) -> None:
    r = ensure_done(run_task("widget_refresh", wait=args.wait))
    n = r.get("widgets", 0)
    _out(args, r, f"桌面小部件已刷新（{n} 个）" if n else "她桌面上还没放「小克」小部件")


def cmd_places(args) -> None:
    r = ensure_done(run_task("places", wait=args.wait))
    rows = [f"{p.get('name')}  半径 {p.get('radius_m')}m" for p in r.get("places") or []]
    head = "后台定位: " + ("已允许" if r.get("background_location") else "没允许（到达提醒不会触发）")
    _out(args, r, head + "\n" + ("\n".join(rows) or "(她还没设地点)"))


def _parse_since(raw: str | None) -> float | None:
    if not raw:
        return None
    text = raw.strip().lower()
    try:
        if text.endswith("d"):
            return float(text[:-1]) * 86400
        return float(_parse_duration(text))
    except (CtlError, ValueError):
        raise CtlError("--since 写 30m / 2h / 1d / 秒数") from None


def cmd_notifs(args) -> None:
    if args.clear:
        r = _request("POST", "/phone/notifs/clear", {})
        _out(args, r, f"已清空 {r.get('cleared', 0)} 条")
        return
    since = _parse_since(args.since)
    path = "/phone/notifs" + (f"?since={since:.0f}" if since is not None else "")
    items = _request("GET", path).get("items") or []
    rows = []
    for i in items:
        ts = datetime.fromtimestamp(i.get("posted_at") or i.get("at") or 0).strftime("%m-%d %H:%M")
        rows.append(f"{ts}  {i.get('app')}: {i.get('title')}" + (f" — {i.get('text')}" if i.get("text") else ""))
    _out(args, {"items": items}, "\n".join(rows) or "(没有)")


def cmd_local(args) -> None:
    device = _request("GET", "/phone/device")["device"]
    info = device.get("local") or {}
    if not info.get("seen"):
        _out(args, info, "服务重启以来 App 还没来领过本地任务（「实时提醒」没开 / 被杀后台 / App 版本 < 1.9.233）")
        return
    lines = [f"App v{info.get('app_version') or '?'}，{info.get('seconds_ago')} 秒前上报"]
    for name, zh in FEATURE_ZH.items():
        f = (info.get("features") or {}).get(name)
        if not f:
            lines.append(f"  {zh}: ?")
            continue
        state = "开" if f.get("enabled") else "关"
        miss = f.get("missing") or []
        lines.append(f"  {zh}: {state}" + (f"，缺: {'、'.join(miss)}" if miss else "")
                     + (f"（{f['note']}）" if f.get("note") else ""))
    _out(args, info, "\n".join(lines))


def cmd_task(args) -> None:
    tasks = _request("GET", "/phone/tasks").get("tasks") or []
    match = [t for t in tasks if t["id"].startswith(args.task_id)]
    if len(match) != 1:
        raise CtlError("找不到唯一匹配的任务 id（结果普通任务留 15 分钟，闹钟 / 强提醒留 6 小时）")
    t = match[0]
    lines = [f"{t['id'][:8]} {t['action']} {t['status']}" + (f" — {t.get('message')}" if t.get("message") else "")]
    if t.get("result"):
        lines.append("结果: " + json.dumps(t["result"], ensure_ascii=False))
    for f in t.get("followup") or []:
        ts = datetime.fromtimestamp(f.get("at") or 0).strftime("%H:%M:%S")
        lines.append(f"后续 {ts}: " + json.dumps({k: v for k, v in f.items() if k != "at"}, ensure_ascii=False))
    _out(args, t, "\n".join(lines))


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="输出原始 JSON")
    common.add_argument("--wait", type=float, default=None, help="等结果的最长秒数 (默认 90, 本地能力 150)")
    p = argparse.ArgumentParser(prog="phone-ctl", description="小克操作方小南的手机（Shizuku）",
                                parents=[common])
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", parents=[common]).set_defaults(fn=cmd_status)
    sub.add_parser("app", parents=[common]).set_defaults(fn=cmd_app)
    s = sub.add_parser("apps", parents=[common]); s.add_argument("--all", action="store_true"); s.set_defaults(fn=cmd_apps)
    s = sub.add_parser("open", parents=[common]); s.add_argument("package"); s.set_defaults(fn=cmd_open)
    s = sub.add_parser("key", parents=[common]); s.add_argument("key"); s.add_argument("--long", action="store_true")
    s.set_defaults(fn=cmd_key)
    for name in ("home", "back", "recent"):
        sub.add_parser(name, parents=[common]).set_defaults(fn=cmd_key)
    s = sub.add_parser("shot", parents=[common]); s.add_argument("out", nargs="?")
    s.add_argument("--max", type=int, default=1280); s.add_argument("--quality", type=int, default=70)
    s.add_argument("--png", action="store_true"); s.add_argument("--full", action="store_true")
    s.set_defaults(fn=cmd_shot)
    s = sub.add_parser("tap", parents=[common]); s.add_argument("x", type=int); s.add_argument("y", type=int)
    s.set_defaults(fn=cmd_tap)
    s = sub.add_parser("swipe", parents=[common])
    for k in ("x1", "y1", "x2", "y2"):
        s.add_argument(k, type=int)
    s.add_argument("ms", type=int, nargs="?", default=300); s.set_defaults(fn=cmd_swipe)
    s = sub.add_parser("longpress", parents=[common]); s.add_argument("x", type=int); s.add_argument("y", type=int)
    s.add_argument("ms", type=int, nargs="?", default=800); s.set_defaults(fn=cmd_longpress)
    s = sub.add_parser("text", parents=[common]); s.add_argument("text"); s.add_argument("--enter", action="store_true")
    s.add_argument("--mode", choices=["auto", "input", "paste"], default="auto"); s.set_defaults(fn=cmd_text)
    s = sub.add_parser("push", parents=[common]); s.add_argument("local"); s.add_argument("dest", nargs="?")
    s.add_argument("--overwrite", action="store_true"); s.add_argument("--timeout", type=int, default=None)
    s.set_defaults(fn=cmd_push)
    s = sub.add_parser("pull", parents=[common]); s.add_argument("remote"); s.add_argument("local", nargs="?")
    s.set_defaults(fn=cmd_pull)
    s = sub.add_parser("ls", parents=[common]); s.add_argument("path", nargs="?", default="/sdcard"); s.set_defaults(fn=cmd_ls)
    s = sub.add_parser("stat", parents=[common]); s.add_argument("path"); s.set_defaults(fn=cmd_stat)
    s = sub.add_parser("sh", parents=[common]); s.add_argument("command"); s.add_argument("--timeout", type=int, default=30)
    s.set_defaults(fn=cmd_sh)
    sub.add_parser("tasks", parents=[common]).set_defaults(fn=cmd_tasks)
    s = sub.add_parser("cancel", parents=[common]); s.add_argument("task_id"); s.set_defaults(fn=cmd_cancel)
    s = sub.add_parser("task", parents=[common]); s.add_argument("task_id"); s.set_defaults(fn=cmd_task)
    # ── 本地能力 ──
    sub.add_parser("local", parents=[common]).set_defaults(fn=cmd_local)
    s = sub.add_parser("alarm", parents=[common]); s.add_argument("time"); s.add_argument("--msg")
    s.add_argument("--days"); s.set_defaults(fn=cmd_alarm)
    s = sub.add_parser("timer", parents=[common]); s.add_argument("seconds"); s.add_argument("--msg")
    s.set_defaults(fn=cmd_timer)
    sub.add_parser("alarms", parents=[common]).set_defaults(fn=cmd_alarms)
    s = sub.add_parser("health", parents=[common]); s.add_argument("date", nargs="?")
    s.add_argument("--range", type=int, default=1); s.set_defaults(fn=cmd_health)
    s = sub.add_parser("calendar", parents=[common]); s.add_argument("what", choices=["sync"])
    s.add_argument("--no-wait", action="store_true"); s.set_defaults(fn=cmd_calendar)
    s = sub.add_parser("ring", parents=[common]); s.add_argument("--msg"); s.add_argument("--seconds", type=int, default=60)
    s.add_argument("--volume", type=int, default=80); s.add_argument("--stop", action="store_true")
    s.set_defaults(fn=cmd_ring)
    s = sub.add_parser("clip", parents=[common]); s.add_argument("text"); s.add_argument("--quiet", action="store_true")
    s.set_defaults(fn=cmd_clip)
    sub.add_parser("widget", parents=[common]).set_defaults(fn=cmd_widget)
    sub.add_parser("places", parents=[common]).set_defaults(fn=cmd_places)
    s = sub.add_parser("notifs", parents=[common]); s.add_argument("--since"); s.add_argument("--clear", action="store_true")
    s.set_defaults(fn=cmd_notifs)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        args.fn(args)
    except CtlError as e:
        print(f"phone-ctl: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
